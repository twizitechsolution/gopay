# Server Port
PORT=5000
NODE_ENV=production

# JWT & Security Secret
JWT_SECRET=Gopay_super_secret_jwt_key_2026

# Admin Credentials
ADMIN_USER=gopayadmin
ADMIN_PASS=gopay@143#!
ADMIN_MOBILE=9999999999
ADMIN_PIN=1234
ADMIN_PASSWORD=admin123

# ========================================================
# Database Configuration for aaPanel (MySQL)
# ========================================================
# Set DB_TYPE=mysql to use your local aaPanel MySQL database
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gopay_db
MYSQL_PASSWORD=your_aapanel_mysql_password
MYSQL_DATABASE=gopay_db

# Or use connection string if preferred:
# DATABASE_URL=mysql://gopay_db:your_password@127.0.0.1:3306/gopay_db
