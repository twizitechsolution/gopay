{
  "version": 2,
  "headers": [
    {
      "source": "/Gopay.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Gopay.apk\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/Gopay_icon.png",
      "destination": "/gopay_icon.png"
    },
    {
      "source": "/gopay.apk",
      "destination": "/Gopay.apk"
    },
    {
      "source": "/api/(.*)",
      "destination": "http://localhost:5000/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "http://localhost:5000/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
